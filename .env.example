# Copy this file to .env and fill in real values. Do NOT commit .env with secrets.

# User to SSH as (e.g. root, ubuntu)
DEPLOY_USER=root

# Hostname or IP of the deployment server
DEPLOY_HOST=REMOVED_DEPLOY_HOST

# Root of the deployment tree on the server. Environments live in {DEPLOY_ROOT}/{environment}, and the
# deploy history in {DEPLOY_ROOT}/deploy-history.
DEPLOY_ROOT=REMOVED_DEPLOY_ROOT

# Path to SSH private key used for deployments. ~ expands to the user's home dir.
SSH_KEY_PATH=
