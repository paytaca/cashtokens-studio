pragma cashscript ^0.14.0;

/**
 * AirdropOptIn 
 * @param adminCategory The Category ID of the project's 
 * @param adminId commitment of Admin AuthNFT
 * @param contractId The AirdropOptIn statically assigned id. Should be > 20000. 20000 below is reserved for Sequential NFT collection.
 */
contract AirdropOptIn(bytes32 adminCategory, int adminId, int contractId) {
    function optIn() {
        bytes32 sidecarNFTCategory = tx.inputs[this.activeInputIndex].tokenCategory.slice(0, 32);
        require(sidecarNFTCategory == adminCategory);
        require(tx.outputs.length <= 3);
        // preserve admin nft
        require(tx.outputs[0].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode);
        require(tx.outputs[0].tokenCategory == tx.inputs[this.activeInputIndex].tokenCategory);
        require(tx.outputs[0].value == tx.inputs[0].value);

        // issuance
        require(tx.outputs[1].lockingBytecode == tx.inputs[1].lockingBytecode);
        require(tx.outputs[1].tokenCategory == adminCategory);
        require(int(tx.outputs[1].nftCommitment) == contractId); 

        if (tx.outputs.length == 3) {
            require(tx.outputs[2].tokenCategory.length == 0);
        }
    }

    // Teardown
    function teardown() {
        bytes32 adminAuthNFT = tx.inputs[0].tokenCategory.slice(0, 32);
        require(int(tx.inputs[0].nftCommitment) == adminId);
        require(adminAuthNFT == adminCategory);
        require(tx.outputs.length == 1);
        require(tx.outputs[0].tokenCategory.length == 0); // change
    }
}
