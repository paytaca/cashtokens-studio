upstream ctswebstaging {
    server 127.0.0.1:3001;
    keepalive 64;
}

upstream ctswebprod {
    server 127.0.0.1:3000;
    keepalive 64;
}

server {
     listen 80;
     client_max_body_size 10M;
     server_name cashtokens.studio;
     add_header Content-Security-Policy "frame-ancestors 'self' https://verify.walletconnect.com https://verify.walletconnect.org";
     location ^~ /.well-known/ {
        allow all;
        root /root/cashtokens-studio/prod;
     }
     location / {
    	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    	proxy_set_header X-Real-IP $remote_addr;
    	proxy_set_header Host $http_host;
        
    	proxy_http_version 1.1;
    	proxy_set_header Upgrade $http_upgrade;
    	proxy_set_header Connection "upgrade";
        
    	proxy_pass http://ctswebprod/;
    	proxy_redirect off;
    	proxy_read_timeout 240s;
    }
}

server {
     listen 80;
     client_max_body_size 10M;
     server_name chipnet.cashtokens.studio;
     location ^~ /.well-known/ {
        allow all;
        root /root/cashtokens-studio/staging;
     }
     location / {
    	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    	proxy_set_header X-Real-IP $remote_addr;
    	proxy_set_header Host $http_host;
        
    	proxy_http_version 1.1;
    	proxy_set_header Upgrade $http_upgrade;
    	proxy_set_header Connection "upgrade";
        
    	proxy_pass http://ctswebstaging/;
    	proxy_redirect off;
    	proxy_read_timeout 240s;
    }
}
